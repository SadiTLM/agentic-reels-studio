# Meta Instagram Graph API (Official Publishing)
# Obtain from Meta for Developers (Instagram Business / Creator account linked to Facebook Page or Instagram Login)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_HOST=graph.instagram.com
IG_GRAPH_VERSION=v25.0

# Optional: Public HTTPS base URL if hosting rendered media externally (otherwise ig_publish.py uses Meta Resumable Upload)
MEDIA_PUBLIC_BASE_URL=

# Optional: Webhook URL for the Landing Page contact/brief form (e.g. Formspree, Make, n8n, custom API)
LANDING_WEBHOOK_URL=

# Optional: Trend Research keys for skills/last30days (Reddit/HN/GitHub/Web also work without keys)
BRAVE_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
SCRAPECREATORS_API_KEY=
